<?xml version="1.0"?>
<!-- Original educational geometry, not a model of commercial hardware. -->
<robot name="Связанный параллельный захват">
  <material name="body"><color rgba="0.35 0.42 0.48 1"/></material>
  <material name="finger"><color rgba="0.72 0.75 0.78 1"/></material>
  <link name="base">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.06 0.10 0.06"/></geometry>
      <material name="body"/>
    </visual>
  </link>
  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.03 0.01 0.10"/></geometry>
      <material name="finger"/>
    </visual>
  </link>
  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.03 0.01 0.10"/></geometry>
      <material name="finger"/>
    </visual>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="base"/><child link="left_finger"/>
    <origin xyz="0 0.005 0.06"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="20" velocity="0.2"/>
  </joint>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="base"/><child link="right_finger"/>
    <origin xyz="0 -0.005 0.06"/><axis xyz="0 -1 0"/>
    <limit lower="0.015" upper="0.04" effort="20" velocity="0.2"/>
    <mimic joint="left_finger_joint"/>
  </joint>
</robot>
